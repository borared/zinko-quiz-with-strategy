# ─── Clerk Keys ──────────────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
# Get this from: Clerk Dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Supabase Keys ───────────────────────────────────────────────────────────
# ⚠️ Replace SUPABASE_SERVICE_ROLE_KEY with your actual service role key
# Found at: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# Groq API
GROQ_API_KEY=your_groq_api_key_here

# ─── Custom JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=fa294cb955fa4f185ad9af14507b41fc12bba611dcd59956c2209396c25adae4
