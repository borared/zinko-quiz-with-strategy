# ─── Clerk Keys ──────────────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
# Get this from: Clerk Dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Database (Supabase Postgres via Prisma) ─────────────────────────────────
# Pooled connection — used by Prisma at runtime
# Found at: Supabase Dashboard → Project Settings → Database → Connection string (Transaction pooler)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection — used by Prisma migrations (must be port 5432, not pooler 6543)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── Prisma Migrate (first-time on existing Supabase DB) ───────────────────
# 1. npm run db:migrate:baseline   # mark baseline as applied (schema already exists)
# 2. npm run db:migrate            # apply FK + index migration
# For new schema changes: npm run db:migrate:dev -- --name your_change_name

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# Groq API
GROQ_API_KEY=your_groq_api_key_here

# ─── Custom JWT ──────────────────────────────────────────────────────────────
# Must be at least 32 characters — generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_at_least_32_chars