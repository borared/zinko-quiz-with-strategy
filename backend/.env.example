# ─── Clerk Keys ──────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → Your App → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# ─── Supabase Keys ───────────────────────────────────────────────────────────
# Get these from https://supabase.com → Your Project → Project Settings → API
# Use the SERVICE ROLE key for the backend (it bypasses RLS — keep it secret!)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Used for CORS — change this to your deployed frontend URL in production
FRONTEND_URL=http://localhost:5173
