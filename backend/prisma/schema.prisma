generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model avatars {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label      String
  image_url  String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

model questions {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quiz_id       String?   @db.Uuid
  question_text String
  image_url     String?
  answers       Json
  order_index   Int
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  round         Int?      @default(1)
  quiz          quizzes?  @relation(fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([quiz_id])
}

model quizzes {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String      @default("Untitled Quiz")
  creator_id  String
  is_public   Boolean?    @default(false)
  is_cloned   Boolean?    @default(false)
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @default(now()) @db.Timestamptz(6)
  cover_image String?
  creator     users       @relation(fields: [creator_id], references: [clerk_id], onDelete: NoAction, onUpdate: NoAction)
  questions   questions[]

  @@index([creator_id])
}

model users {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerk_id      String          @unique
  email         String?
  first_name    String?
  last_name     String?
  username      String?
  avatar_url    String?
  created_at    DateTime        @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at    DateTime        @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  quizzes       quizzes[]
  notifications notifications[]
}

model notifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String
  type       String   @default("QUIZ_CLONED")
  message    String
  metadata   Json?
  is_read    Boolean  @default(false)
  created_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  user       users    @relation(fields: [user_id], references: [clerk_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
}